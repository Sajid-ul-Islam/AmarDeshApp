# Production Environment Variables
APP_ENV=production
API_URL=https://api.dailyamardesh.com
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true

# Feature Flags
ENABLE_EXPO_IMAGE=true
ENABLE_NOTIFICATIONS=true
ENABLE_HAPTICS=true

# AI Service (BYoak - User provides their own key)
# Users will enter their API keys in the app settings

# Analytics (Production)
ANALYTICS_KEY=production-analytics-key

# Push Notifications (Production)
PUSH_NOTIFICATION_KEY=production-push-key

# IMPORTANT: Never commit actual production secrets to git
# Use EAS Secrets for sensitive values:
# eas secret:create --name "API_KEY" --value "your-secret-key"
