# Development Environment Variables
APP_ENV=development
API_URL=https://api.dailyamardesh.com/dev
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false

# Feature Flags
ENABLE_EXPO_IMAGE=true
ENABLE_NOTIFICATIONS=true
ENABLE_HAPTICS=true

# AI Service (BYoak - User provides their own key)
# Users will enter their API keys in the app settings

# Analytics (Development)
ANALYTICS_KEY=dev-analytics-key

# Push Notifications (Development)
PUSH_NOTIFICATION_KEY=dev-push-key
