{
  "expo": {
    "name": "আমার দেশ",
    "slug": "amar-desh-mobile",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "amardesh",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amardesh.mobile",
      "associatedDomains": [
        "applinks:www.dailyamardesh.com",
        "applinks:dailyamardesh.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Allow camera access to share photos",
        "NSPhotoLibraryUsageDescription": "Allow photo library access to share images",
        "NSUserNotificationsUsageDescription": "Allow notifications to receive breaking news and daily briefings"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#006B3F"
      },
      "package": "com.amardesh.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.dailyamardesh.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "dailyamardesh.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#006B3F",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/amardesh_logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/amardesh_logo.png",
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "auto"
        }
      ],
      "expo-sharing",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0ea4bfdf-df15-4a62-8bb4-7ad00b0f8dd7"
      },
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "auto",
        "hidden": false
      }
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "owner": "sajid.islam"
  }
}
