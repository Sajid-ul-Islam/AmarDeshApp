# Firebase Configuration
# Get these values from your Firebase project settings
# https://console.firebase.google.com/

EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Optional: Firebase Measurement ID (for Analytics)
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: RSS Feed URL (defaults to dailyamardesh.com)
EXPO_PUBLIC_RSS_FEED_URL=https://www.dailyamardesh.com/feed

# Optional: Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false

# Optional: API Keys for AI Features (BYOAK - Bring Your Own API Key)
# Users can enter their own keys in the app settings
# These are optional defaults
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_GOOGLE_AI_API_KEY=

# Development Settings
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_LOG_LEVEL=debug
