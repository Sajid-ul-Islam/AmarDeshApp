# Staging Environment Variables
APP_ENV=staging
API_URL=https://api.dailyamardesh.com/staging
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true

# Feature Flags
ENABLE_EXPO_IMAGE=true
ENABLE_NOTIFICATIONS=true
ENABLE_HAPTICS=true

# AI Service (BYoak - User provides their own key)
# Users will enter their API keys in the app settings

# Analytics (Staging)
ANALYTICS_KEY=staging-analytics-key

# Push Notifications (Staging)
PUSH_NOTIFICATION_KEY=staging-push-key
